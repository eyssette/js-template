{
	"name": "js-template",
	"version": "9.0.0",
	"description": "Environnement de développement JavaScript pré-configuré et optimisé.Éditeur de code qui vérifie la qualité du code, le formate automatiquement et facilite le débogage, Tâches automatisées pour compiler, tester, pousser, déployer et vérifier l’application. Pré-configuration pour agents IA avec des SKILLS déjà définis. Gestion de l'internationalisation et du mode PWA (Progressive Web App) pour utilisation hors ligne.",
	"keywords": [
		"javascript",
		"template"
	],
	"license": "MIT",
	"author": "Cédric Eyssette",
	"repository": {
		"type": "git",
		"url": "git@forge.apps.education.fr:eyssette/js-template.git"
	},
	"directories": {
		"test": "tests"
	},
	"type": "module",
	"main": "app/js/main.js",
	"scripts": {
		"build": "npx task build",
		"dev": "npx task dev",
		"debug": "npx task debug",
		"debug-stop": "npx task dev:stop",
		"bundle-size": "npx task bundle-size",
		"test": "npx task tests",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@e18e/eslint-plugin": "^0.5.1",
		"@go-task/cli": "^3.52.0",
		"@inlang/paraglide-js": "^2.23.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"codeceptjs": "^4.1.0",
		"es-check": "^9.6.4",
		"eslint-plugin-codeceptjs": "^1.3.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jasmine": "^6.3.0",
		"jsdom": "^29.1.1",
		"lightningcss": "^1.33.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"playwright": "1.56.1",
		"rolldown": "^1.2.0",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-livereload": "^2.0.5",
		"rollup-plugin-serve": "^3.0.0",
		"rollup-plugin-svelte": "^7.2.3",
		"rollup-plugin-visualizer": "^7.0.1",
		"stylelint-config-standard": "^40.0.0",
		"unplugin-raw": "^0.7.0"
	},
	"overrides": {
