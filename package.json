		"brace-expansion": ">=5.0.8",
		"diff": ">=8.0.3",
		"fast-uri": ">=3.1.5",
		"hono": ">=4.12.34",
		"js-yaml": ">=4.3.1",
		"serialize-javascript": ">=7.0.7",
		"tar": ">=7.5.22",
		"undici": ">=6.27.0",
		"uuid": ">=11.1.1"
	},
	"engines": {
		"node": ">=22"
	},
	"volta": {
		"node": "24.18.1",
		"npm": "11.16.0"
	},
	"allowScripts": {
		"@go-task/cli@3.52.0": true
	}
}
